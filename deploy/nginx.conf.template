server {
    listen ${PORT};
    listen [::]:${PORT};
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Render checks this to know the site is up.
    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Built files have hashed names, so browsers may cache them forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Every page (/listing/..., /messages, ...) is handled by the app itself.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
